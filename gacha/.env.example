# Supabase（プロジェクト設定 → API）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role キー。公開しないこと（サーバーだけで使う）

# 管理画面のパスワード（/admin で入力）
ADMIN_PASSWORD=change-me

# クーポンコードとログインに使う秘密の文字列（長いランダム文字列にする）
SESSION_SECRET=change-me-to-a-long-random-string

# 営業日の切り替え時刻（この時刻までは前日扱い。初期値 6 = 朝6時）
BUSINESS_DAY_CUTOFF_HOUR=6
